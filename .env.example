# Devin API — create under Settings -> Devin API -> Service users.
DEVIN_API_KEY=cog_replace_me
DEVIN_ORG_ID=replace_me

# GitHub — fine-grained PAT scoped to the target repo with:
# Issues: read/write; Pull requests: read-only; Metadata: read-only.
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REPO=jrios6/superset

# Trigger configuration
TRIGGER_LABEL=devin-fix
# Set >0 to poll for labeled issues (local/demo mode, no public webhook needed)
POLL_INTERVAL_SECONDS=60
TRACK_INTERVAL_SECONDS=30
# HMAC secret if you point a real GitHub webhook at /webhooks/github
GITHUB_WEBHOOK_SECRET=
# Gate mutating endpoints (/scan, /dispatch, /api/config, /api/poller) behind a
# shared token — set when the service is publicly reachable; empty = open (local dev)
DASHBOARD_TOKEN=

# Safety rails
DEVIN_MAX_ACU_LIMIT=10
# Agent mode for spawned sessions: normal|fast|lite|ultra|fusion (empty = org default)
DEVIN_MODE=
DB_PATH=/data/remediator.db
